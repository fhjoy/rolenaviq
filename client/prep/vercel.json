{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist/site",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rolenaviq.onrender.com/api/:path*"
    },
    {
      "source": "/prep",
      "destination": "/prep/index.html"
    },
    {
      "source": "/prep/:path*",
      "destination": "/prep/index.html"
    }
  ]
}
