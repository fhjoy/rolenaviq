{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rolenaviq.onrender.com/api/:path*"
    },
    {
      "source": "/prep",
      "destination": "https://rolenaviq-prep.vercel.app/prep/"
    },
    {
      "source": "/prep/",
      "destination": "https://rolenaviq-prep.vercel.app/prep/"
    },
    {
      "source": "/prep/:path*",
      "destination": "https://rolenaviq-prep.vercel.app/prep/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}

